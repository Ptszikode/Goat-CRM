import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Skeleton } from "@/components/ui/skeleton";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Textarea } from "@/components/ui/textarea";
import { useAuth } from "@/_core/hooks/useAuth";
import { trpc } from "@/lib/trpc";
import {
  ArrowLeft, Baby, Camera, CheckCircle, Edit, Heart, Image, Scale, Skull, Trash2
} from "lucide-react";
import { useRef, useState } from "react";
import { useLocation, useParams } from "wouter";
import { toast } from "sonner";
import {
  CartesianGrid, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis,
} from "recharts";

const HEALTH_BADGE: Record<string, string> = {
  Healthy: "bg-emerald-100 text-emerald-800 border-emerald-200",
  Sick: "bg-red-100 text-red-800 border-red-200",
  Under_Treatment: "bg-amber-100 text-amber-800 border-amber-200",
  Quarantine: "bg-orange-100 text-orange-800 border-orange-200",
  Deceased: "bg-gray-100 text-gray-600 border-gray-200",
};

export default function GoatDetail() {
  const [, setLocation] = useLocation();
  const params = useParams<{ id: string }>();
  const goatId = Number(params.id);
  const { user } = useAuth();
  const canWrite = user?.role !== "viewer";

  const { data: goat, isLoading, refetch } = trpc.goats.getById.useQuery({ id: goatId });
  const { data: breeds } = trpc.reference.getBreeds.useQuery();
  const { data: weightHistory } = trpc.weight.getHistory.useQuery({ goatId });
  const { data: breedComparison } = trpc.weight.getBreedComparison.useQuery({ goatId });
  const { data: photos, refetch: refetchPhotos } = trpc.photos.getPhotos.useQuery({ goatId });
  const { data: pedigree } = trpc.breeding.getPedigree.useQuery({ goatId, generations: 3 });
  const utils = trpc.useUtils();

  const deactivateMutation = trpc.goats.deactivate.useMutation({
    onSuccess: () => { toast.success("Goat deactivated"); utils.goats.list.invalidate(); refetch(); },
    onError: (e) => toast.error(e.message),
  });
  const reactivateMutation = trpc.goats.reactivate.useMutation({
    onSuccess: () => { toast.success("Goat reactivated"); utils.goats.list.invalidate(); refetch(); },
    onError: (e) => toast.error(e.message),
  });
  const markHealthyMutation = trpc.health.markHealthy.useMutation({
    onSuccess: () => { toast.success("Marked as healthy"); refetch(); },
    onError: (e) => toast.error(e.message),
  });

  // Health record form
  const [healthForm, setHealthForm] = useState({
    recordType: "Vaccination" as "Vaccination" | "Treatment" | "Deworming" | "Checkup" | "Surgery",
    productUsed: "", dosage: "", vetName: "", date: new Date().toISOString().split("T")[0]!,
    nextDueDate: "", cost: "", notes: "",
  });
  const addHealthMutation = trpc.health.addRecord.useMutation({
    onSuccess: () => { toast.success("Health record added"); refetch(); setHealthDialogOpen(false); },
    onError: (e) => toast.error(e.message),
  });
  const [healthDialogOpen, setHealthDialogOpen] = useState(false);

  // Weight record form
  const [weightForm, setWeightForm] = useState({
    weightKg: "", date: new Date().toISOString().split("T")[0]!, method: "Scale" as "Scale" | "Tape_Measure" | "Estimate",
  });
  const addWeightMutation = trpc.weight.record.useMutation({
    onSuccess: () => { toast.success("Weight recorded"); refetch(); utils.weight.getHistory.invalidate({ goatId }); setWeightDialogOpen(false); },
    onError: (e) => toast.error(e.message),
  });
  const [weightDialogOpen, setWeightDialogOpen] = useState(false);

  // Photo upload
  const fileInputRef = useRef<HTMLInputElement>(null);
  const uploadPhotoMutation = trpc.photos.uploadPhoto.useMutation({
    onSuccess: () => { toast.success("Photo uploaded"); refetchPhotos(); },
    onError: (e) => toast.error(e.message),
  });
  const setPrimaryMutation = trpc.photos.setPrimary.useMutation({
    onSuccess: () => { toast.success("Primary photo set"); refetchPhotos(); },
    onError: (e) => toast.error(e.message),
  });
  const deletePhotoMutation = trpc.photos.deletePhoto.useMutation({
    onSuccess: () => { toast.success("Photo deleted"); refetchPhotos(); },
    onError: (e) => toast.error(e.message),
  });

  const handlePhotoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const base64 = (ev.target?.result as string).split(",")[1];
      if (base64) {
        uploadPhotoMutation.mutate({ goatId, imageBase64: base64, mimeType: file.type, label: "General" });
      }
    };
    reader.readAsDataURL(file);
  };

  if (isLoading) {
    return (
      <div className="space-y-4">
        <Skeleton className="h-8 w-64" />
        <Skeleton className="h-48 w-full rounded-xl" />
        <Skeleton className="h-64 w-full rounded-xl" />
      </div>
    );
  }

  if (!goat) return <div className="text-muted-foreground">Goat not found</div>;

  const breed = breeds?.find(b => b.id === goat.breedId);
  const weightChartData = (weightHistory ?? []).map((w: { date: Date | string; weightKg: number }) => ({
    date: new Date(w.date).toLocaleDateString(),
    weight: w.weightKg,
  }));

  return (
    <div className="space-y-5">
      {/* Header */}
      <div className="flex items-start justify-between">
        <div className="flex items-center gap-3">
          <Button variant="ghost" size="sm" onClick={() => setLocation("/goats")} className="gap-2">
            <ArrowLeft className="h-4 w-4" />
            Back
          </Button>
          <div>
            <div className="flex items-center gap-3">
              <h1 className="text-2xl font-serif font-semibold">{goat.tagNumber}</h1>
              {goat.name && <span className="text-lg text-muted-foreground">— {goat.name}</span>}
              <Badge variant="outline" className={`${HEALTH_BADGE[goat.healthStatus] ?? ""}`}>
                {goat.healthStatus.replace("_", " ")}
              </Badge>
              <Badge variant={goat.isActive ? "default" : "secondary"}>
                {goat.isActive ? "Active" : "Inactive"}
              </Badge>
            </div>
            <p className="text-sm text-muted-foreground mt-0.5">
              {goat.gender} · {breed?.name ?? "Unknown breed"}
            </p>
          </div>
        </div>
        {canWrite && (
          <div className="flex gap-2">
            <Button variant="outline" size="sm" onClick={() => setLocation(`/goats/${goatId}/edit`)} className="gap-2">
              <Edit className="h-4 w-4" />
              Edit
            </Button>
            {goat.healthStatus !== "Healthy" && goat.isActive && (
              <Button variant="outline" size="sm" onClick={() => markHealthyMutation.mutate({ goatId })} className="gap-2 text-emerald-700 border-emerald-300 hover:bg-emerald-50">
                <CheckCircle className="h-4 w-4" />
                Mark Healthy
              </Button>
            )}
            {goat.isActive ? (
              <Button variant="outline" size="sm" onClick={() => deactivateMutation.mutate({ id: goatId })} className="gap-2 text-destructive border-destructive/30 hover:bg-destructive/5">
                <Skull className="h-4 w-4" />
                Deactivate
              </Button>
            ) : (
              <Button variant="outline" size="sm" onClick={() => reactivateMutation.mutate({ id: goatId })} className="gap-2">
                Reactivate
              </Button>
            )}
          </div>
        )}
      </div>

      <Tabs defaultValue="info">
        <TabsList className="bg-muted/50">
          <TabsTrigger value="info">Info</TabsTrigger>
          <TabsTrigger value="health">Health</TabsTrigger>
          <TabsTrigger value="weight">Weight</TabsTrigger>
          <TabsTrigger value="breeding">Breeding</TabsTrigger>
          <TabsTrigger value="photos">Photos</TabsTrigger>
        </TabsList>

        {/* Info Tab */}
        <TabsContent value="info" className="space-y-4 mt-4">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <Card>
              <CardHeader className="pb-2"><CardTitle className="text-sm font-medium text-muted-foreground uppercase tracking-wide">Identity</CardTitle></CardHeader>
              <CardContent className="space-y-3">
                {[
                  ["Tag Number", goat.tagNumber],
                  ["Name", goat.name ?? "—"],
                  ["Gender", goat.gender],
                  ["Breed", breed?.name ?? "Unknown"],
                  ["Date of Birth", goat.dateOfBirth ? new Date(goat.dateOfBirth).toLocaleDateString() : "—"],
                  ["Age", goat.dateOfBirth ? (() => {
                    const months = Math.floor((Date.now() - new Date(goat.dateOfBirth!).getTime()) / (1000 * 60 * 60 * 24 * 30));
                    return months < 12 ? `${months} months` : `${Math.floor(months / 12)} years ${months % 12} months`;
                  })() : "—"],
                ].map(([label, value]) => (
                  <div key={label} className="flex justify-between text-sm">
                    <span className="text-muted-foreground">{label}</span>
                    <span className="font-medium">{value}</span>
                  </div>
                ))}
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="pb-2"><CardTitle className="text-sm font-medium text-muted-foreground uppercase tracking-wide">Physical & Location</CardTitle></CardHeader>
              <CardContent className="space-y-3">
                {[
                  ["Weight", goat.weightKg ? `${goat.weightKg} kg` : "—"],
                  ["Camp / Location", goat.locationCamp ?? "—"],
                  ["Health Status", goat.healthStatus.replace("_", " ")],
                  ["Dam (Mother) ID", goat.damId ? String(goat.damId) : "—"],
                  ["Sire (Father) ID", goat.sireId ? String(goat.sireId) : "—"],
                  ["Registration #", goat.registrationNumber ?? "—"],
                ].map(([label, value]) => (
                  <div key={label} className="flex justify-between text-sm">
                    <span className="text-muted-foreground">{label}</span>
                    <span className="font-medium">{value}</span>
                  </div>
                ))}
              </CardContent>
            </Card>
          </div>
          {pedigree ? (
            <Card>
              <CardHeader className="pb-2"><CardTitle className="text-sm font-medium text-muted-foreground uppercase tracking-wide">Pedigree (3 Generations)</CardTitle></CardHeader>
              <CardContent>
                <PedigreeTree node={pedigree as PedigreeNode} />
              </CardContent>
            </Card>
          ) : null}
        </TabsContent>

        {/* Health Tab */}
        <TabsContent value="health" className="space-y-4 mt-4">
          <div className="flex justify-between items-center">
            <h3 className="font-medium">Health History</h3>
            {canWrite && (
              <Dialog open={healthDialogOpen} onOpenChange={setHealthDialogOpen}>
                <DialogTrigger asChild>
                  <Button size="sm" className="gap-2"><Heart className="h-4 w-4" />Add Record</Button>
                </DialogTrigger>
                <DialogContent>
                  <DialogHeader><DialogTitle>Add Health Record</DialogTitle></DialogHeader>
                  <div className="space-y-3">
                    <div className="space-y-1.5">
                      <Label>Type</Label>
                      <Select value={healthForm.recordType} onValueChange={v => setHealthForm(f => ({ ...f, recordType: v as typeof f.recordType }))}>
                        <SelectTrigger><SelectValue /></SelectTrigger>
                        <SelectContent>
                          {["Vaccination", "Treatment", "Deworming", "Checkup", "Surgery"].map(t => (
                            <SelectItem key={t} value={t}>{t}</SelectItem>
                          ))}
                        </SelectContent>
                      </Select>
                    </div>
                    <div className="grid grid-cols-2 gap-3">
                      <div className="space-y-1.5">
                        <Label>Product Used</Label>
                        <Input value={healthForm.productUsed} onChange={e => setHealthForm(f => ({ ...f, productUsed: e.target.value }))} />
                      </div>
                      <div className="space-y-1.5">
                        <Label>Dosage</Label>
                        <Input value={healthForm.dosage} onChange={e => setHealthForm(f => ({ ...f, dosage: e.target.value }))} />
                      </div>
                      <div className="space-y-1.5">
                        <Label>Date *</Label>
                        <Input type="date" value={healthForm.date} onChange={e => setHealthForm(f => ({ ...f, date: e.target.value }))} />
                      </div>
                      <div className="space-y-1.5">
                        <Label>Next Due Date</Label>
                        <Input type="date" value={healthForm.nextDueDate} onChange={e => setHealthForm(f => ({ ...f, nextDueDate: e.target.value }))} />
                      </div>
                      <div className="space-y-1.5">
                        <Label>Vet Name</Label>
                        <Input value={healthForm.vetName} onChange={e => setHealthForm(f => ({ ...f, vetName: e.target.value }))} />
                      </div>
                      <div className="space-y-1.5">
                        <Label>Cost</Label>
                        <Input type="number" value={healthForm.cost} onChange={e => setHealthForm(f => ({ ...f, cost: e.target.value }))} />
                      </div>
                    </div>
                    <div className="space-y-1.5">
                      <Label>Notes</Label>
                      <Textarea value={healthForm.notes} onChange={e => setHealthForm(f => ({ ...f, notes: e.target.value }))} rows={2} />
                    </div>
                    <Button className="w-full" onClick={() => addHealthMutation.mutate({ goatId, ...healthForm, cost: healthForm.cost ? Number(healthForm.cost) : undefined, nextDueDate: healthForm.nextDueDate || undefined })} disabled={addHealthMutation.isPending}>
                      {addHealthMutation.isPending ? "Saving..." : "Save Record"}
                    </Button>
                  </div>
                </DialogContent>
              </Dialog>
            )}
          </div>
          <Card>
            <CardContent className="p-0">
              {(goat.healthHistory ?? []).length === 0 ? (
                <p className="text-sm text-muted-foreground p-6 text-center">No health records yet</p>
              ) : (
                <div className="divide-y">
                  {(goat.healthHistory as {
                    id: number; recordType: string; productUsed?: string | null;
                    date: Date | string; nextDueDate?: Date | string | null;
                    vetName?: string | null; cost?: number | null; notes?: string | null;
                  }[]).map(h => (
                    <div key={h.id} className="p-4 flex items-start justify-between">
                      <div>
                        <div className="flex items-center gap-2">
                          <Badge variant="outline" className="text-xs">{h.recordType}</Badge>
                          {h.productUsed && <span className="text-sm font-medium">{h.productUsed}</span>}
                        </div>
                        <p className="text-xs text-muted-foreground mt-1">
                          {new Date(h.date).toLocaleDateString()}
                          {h.vetName && ` · ${h.vetName}`}
                          {h.cost != null && ` · $${h.cost}`}
                        </p>
                        {h.notes && <p className="text-xs text-muted-foreground mt-1">{h.notes}</p>}
                      </div>
                      {h.nextDueDate && (
                        <Badge variant="outline" className="text-xs text-amber-700 border-amber-300 bg-amber-50">
                          Due: {new Date(h.nextDueDate).toLocaleDateString()}
                        </Badge>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </CardContent>
          </Card>
        </TabsContent>

        {/* Weight Tab */}
        <TabsContent value="weight" className="space-y-4 mt-4">
          <div className="flex justify-between items-center">
            <h3 className="font-medium">Weight History</h3>
            {canWrite && (
              <Dialog open={weightDialogOpen} onOpenChange={setWeightDialogOpen}>
                <DialogTrigger asChild>
                  <Button size="sm" className="gap-2"><Scale className="h-4 w-4" />Record Weight</Button>
                </DialogTrigger>
                <DialogContent>
                  <DialogHeader><DialogTitle>Record Weight</DialogTitle></DialogHeader>
                  <div className="space-y-3">
                    <div className="space-y-1.5">
                      <Label>Weight (kg) *</Label>
                      <Input type="number" step="0.1" value={weightForm.weightKg} onChange={e => setWeightForm(f => ({ ...f, weightKg: e.target.value }))} placeholder="e.g. 45.5" />
                    </div>
                    <div className="space-y-1.5">
                      <Label>Date *</Label>
                      <Input type="date" value={weightForm.date} onChange={e => setWeightForm(f => ({ ...f, date: e.target.value }))} />
                    </div>
                    <div className="space-y-1.5">
                      <Label>Method</Label>
                      <Select value={weightForm.method} onValueChange={v => setWeightForm(f => ({ ...f, method: v as typeof f.method }))}>
                        <SelectTrigger><SelectValue /></SelectTrigger>
                        <SelectContent>
                          <SelectItem value="Scale">Scale</SelectItem>
                          <SelectItem value="Tape_Measure">Tape Measure</SelectItem>
                          <SelectItem value="Estimate">Estimate</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                    <Button className="w-full" onClick={() => addWeightMutation.mutate({ goatId, weightKg: Number(weightForm.weightKg), date: weightForm.date, method: weightForm.method })} disabled={addWeightMutation.isPending || !weightForm.weightKg}>
                      {addWeightMutation.isPending ? "Saving..." : "Save Weight"}
                    </Button>
                  </div>
                </DialogContent>
              </Dialog>
            )}
          </div>
          {breedComparison?.standard && (
            <Card className="border-amber-200 bg-amber-50">
              <CardContent className="p-4 flex items-center justify-between">
                <div>
                  <p className="text-sm font-medium text-amber-900">Breed Standard Comparison</p>
                  <p className="text-xs text-amber-700 mt-0.5">
                    Current: {breedComparison.actual ?? "—"} kg · Standard: {breedComparison.standard} kg
                  </p>
                </div>
                {breedComparison.deviation != null && (
                  <Badge className={`${Math.abs(breedComparison.deviation) > 15 ? "bg-red-100 text-red-800 border-red-200" : "bg-emerald-100 text-emerald-800 border-emerald-200"} border`}>
                    {breedComparison.deviation > 0 ? "+" : ""}{breedComparison.deviation.toFixed(1)}%
                  </Badge>
                )}
              </CardContent>
            </Card>
          )}
          {weightChartData.length > 1 ? (
            <Card>
              <CardHeader className="pb-2"><CardTitle className="text-sm font-medium">Growth Curve</CardTitle></CardHeader>
              <CardContent>
                <ResponsiveContainer width="100%" height={220}>
                  <LineChart data={weightChartData}>
                    <CartesianGrid strokeDasharray="3 3" stroke="hsl(var(--border))" />
                    <XAxis dataKey="date" tick={{ fontSize: 11 }} />
                    <YAxis tick={{ fontSize: 11 }} unit=" kg" />
                    <Tooltip formatter={(v: number) => [`${v} kg`, "Weight"]} />
                    <Line type="monotone" dataKey="weight" stroke="hsl(var(--primary))" strokeWidth={2} dot={{ r: 4 }} />
                  </LineChart>
                </ResponsiveContainer>
              </CardContent>
            </Card>
          ) : (
            <Card>
              <CardContent className="p-6 text-center text-sm text-muted-foreground">
                {weightChartData.length === 0 ? "No weight records yet" : "Add at least 2 records to see the growth curve"}
              </CardContent>
            </Card>
          )}
          <Card>
            <CardContent className="p-0">
              <div className="divide-y">
                {(weightHistory ?? []).slice().reverse().map((w: { id: number; weightKg: number; date: Date | string; method?: string | null }) => (
                  <div key={w.id} className="p-3 flex justify-between text-sm">
                    <span className="text-muted-foreground">{new Date(w.date).toLocaleDateString()}</span>
                    <span className="font-medium">{w.weightKg} kg</span>
                    <span className="text-muted-foreground text-xs">{w.method?.replace("_", " ") ?? ""}</span>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        </TabsContent>

        {/* Breeding Tab */}
        <TabsContent value="breeding" className="space-y-4 mt-4">
          <p className="text-sm text-muted-foreground">
            View breeding records for this goat in the{" "}
            <button className="text-primary underline" onClick={() => setLocation("/breeding")}>Breeding module</button>.
          </p>
        </TabsContent>

        {/* Photos Tab */}
        <TabsContent value="photos" className="space-y-4 mt-4">
          <div className="flex justify-between items-center">
            <h3 className="font-medium">Photos</h3>
            {canWrite && (
              <>
                <Button size="sm" className="gap-2" onClick={() => fileInputRef.current?.click()} disabled={uploadPhotoMutation.isPending}>
                  <Camera className="h-4 w-4" />
                  {uploadPhotoMutation.isPending ? "Uploading..." : "Upload Photo"}
                </Button>
                <input ref={fileInputRef} type="file" accept="image/*" className="hidden" onChange={handlePhotoUpload} />
              </>
            )}
          </div>
          {(photos ?? []).length === 0 ? (
            <Card>
              <CardContent className="p-12 flex flex-col items-center text-center">
                <Image className="h-12 w-12 text-muted-foreground/30 mb-3" />
                <p className="text-sm text-muted-foreground">No photos yet</p>
                {canWrite && <p className="text-xs text-muted-foreground mt-1">Click "Upload Photo" to add the first photo</p>}
              </CardContent>
            </Card>
          ) : (
            <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
              {(photos as {
                id: number; imageUrl: string; label?: string | null; isPrimary: boolean;
              }[]).map(photo => (
                <div key={photo.id} className="relative group rounded-xl overflow-hidden border border-border aspect-square bg-muted">
                  <img src={photo.imageUrl} alt="Goat photo" className="w-full h-full object-cover" />
                  {photo.isPrimary && (
                    <Badge className="absolute top-2 left-2 text-xs bg-primary/90">Primary</Badge>
                  )}
                  {photo.label && (
                    <Badge variant="outline" className="absolute bottom-2 left-2 text-xs bg-white/90">
                      {photo.label.replace("_", " ")}
                    </Badge>
                  )}
                  {canWrite && (
                    <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                      {!photo.isPrimary && (
                        <Button size="sm" variant="secondary" className="text-xs h-7" onClick={() => setPrimaryMutation.mutate({ photoId: photo.id, goatId })}>
                          Set Primary
                        </Button>
                      )}
                      <Button size="sm" variant="destructive" className="text-xs h-7" onClick={() => deletePhotoMutation.mutate({ photoId: photo.id, goatId })}>
                        <Trash2 className="h-3 w-3" />
                      </Button>
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </TabsContent>
      </Tabs>
    </div>
  );
}

type PedigreeNode = { id: number; tagNumber: string; name?: string | null; gender?: string | null; dam?: PedigreeNode | null; sire?: PedigreeNode | null } | null;

// Simple pedigree tree component
function PedigreeTree({ node, depth = 0 }: { node: PedigreeNode; depth?: number }) {
  if (!node) return <span className="text-xs text-muted-foreground italic">Unknown</span>;
  return (
    <div className={`flex flex-col gap-1 ${depth > 0 ? "pl-4 border-l border-border" : ""}`}>
      <div className="flex items-center gap-2">
        <span className="text-sm font-medium">{node.tagNumber}</span>
        {node.name && <span className="text-xs text-muted-foreground">{node.name}</span>}
        {node.gender && <Badge variant="outline" className="text-xs">{node.gender}</Badge>}
      </div>
      {depth < 3 && (node.dam || node.sire) && (
        <div className="pl-2 space-y-1 mt-1">
          {node.dam && (
            <div className="text-xs text-muted-foreground">Dam: <PedigreeTree node={node.dam} depth={depth + 1} /></div>
          )}
          {node.sire && (
            <div className="text-xs text-muted-foreground">Sire: <PedigreeTree node={node.sire} depth={depth + 1} /></div>
          )}
        </div>
      )}
    </div>
  );
}
