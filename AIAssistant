import { AIChatBox } from "@/components/AIChatBox";
import type { Message } from "@/components/AIChatBox";
import { trpc } from "@/lib/trpc";
import { useState } from "react";

const SYSTEM_PROMPT = `You are an expert goat farming assistant with deep knowledge of:
- Goat health, diseases, vaccinations, and treatments
- Breeding management, gestation periods, and kidding
- Nutrition, weight management, and growth standards
- Farm management best practices
- Goat breeds and their characteristics

Provide practical, accurate advice. When discussing health issues, always recommend consulting a veterinarian for serious conditions.`;

const SUGGESTED_PROMPTS = [
  "What vaccinations does my goat herd need?",
  "How do I manage a doe during kidding?",
  "What are signs of common goat diseases?",
  "How should I feed goats for optimal weight gain?",
  "What is the gestation period for goats?",
  "How do I prevent and treat internal parasites?",
];

export default function AIAssistant() {
  const [messages, setMessages] = useState<Message[]>([
    { role: "system", content: SYSTEM_PROMPT },
  ]);
  const [isLoading, setIsLoading] = useState(false);

  const askMutation = trpc.ai.ask.useMutation({
    onSuccess: (response: { content: string }) => {
      setMessages(prev => [...prev, { role: "assistant", content: response.content }]);
      setIsLoading(false);
    },
    onError: (e: { message: string }) => {
      setMessages(prev => [...prev, { role: "assistant", content: `Sorry, I encountered an error: ${e.message}` }]);
      setIsLoading(false);
    },
  });

  const handleSendMessage = (content: string) => {
    const userMessage: Message = { role: "user", content };
    const newMessages = [...messages, userMessage];
    setMessages(newMessages);
    setIsLoading(true);
    askMutation.mutate({
      messages: newMessages.map(m => ({ role: m.role as "system" | "user" | "assistant", content: m.content })),
    });
  };

  return (
    <div className="flex flex-col h-[calc(100vh-8rem)]">
      <div className="mb-4">
        <h1 className="text-2xl font-serif font-semibold">AI Assistant</h1>
        <p className="text-sm text-muted-foreground mt-0.5">Ask questions about goat farming, health, and management</p>
      </div>
      <div className="flex-1 min-h-0">
        <AIChatBox
          messages={messages}
          onSendMessage={handleSendMessage}
          isLoading={isLoading}
          placeholder="Ask about goat health, breeding, nutrition..."
          emptyStateMessage="Ask me anything about goat farming"
          suggestedPrompts={SUGGESTED_PROMPTS}
          height="100%"
        />
      </div>
    </div>
  );
}
